<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the t3-feedback Receiver: opens a T3 Code Thread for each Feedback.
  launchd expands neither ~ nor $HOME, so docs/setup-macos.md replaces __HOME__ and
  __NODE__ (the absolute path of a Node 22+ binary) when it installs this file.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.anovoselnik.t3-feedback-receiver</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>receiver/main.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/.local/share/t3-feedback</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/t3-feedback-receiver.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/t3-feedback-receiver.log</string>
</dict>
</plist>
